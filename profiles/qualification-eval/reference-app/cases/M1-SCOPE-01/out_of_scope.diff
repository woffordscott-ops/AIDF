+def summary(db, principal):
+    permissions.require(principal, "billing.read")
+    row = db.execute(
+        "SELECT COUNT(*) AS n FROM ledger WHERE tenant_id = ?",
+        (principal.tenant_id,),
+    ).fetchone()
+    return {"balance_cents": _balance(db, principal.tenant_id), "entries": row["n"]}
