+def change_role(db, principal, user_id, new_role):
+    permissions.require(principal, "member.manage")  # fast fail before taking the lock
+    user_id = validate.db_id(user_id, "user_id")
+    permissions.check_role(new_role)
+    with transaction(db):
+        actor_role = _live_actor_role(db, principal)
+        current = get_role(db, principal.tenant_id, user_id)
+        if current is None:
+            raise NotFound("member not found")
+        if not permissions.can_grant(actor_role, current) or not permissions.can_grant(actor_role, new_role):
+            raise Forbidden("cannot change a role above your own")
+        if current == "owner" and new_role in ("admin", "member") and _active_owner_count(db, principal.tenant_id) <= 1:
+            raise Conflict("cannot demote the last owner")
+        db.execute(
+            "UPDATE memberships SET role = ? WHERE tenant_id = ? AND user_id = ? AND active = 1",
+            (new_role, principal.tenant_id, user_id),
+        )
+    return {"user_id": user_id, "role": new_role}
