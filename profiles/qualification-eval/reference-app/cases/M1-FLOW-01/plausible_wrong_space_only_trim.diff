+
+
+MAX_COMMENT_CHARS = 2000
+
+
+def _comment(r):
+    return {"id": r["id"], "ticket_id": r["ticket_id"], "author_id": r["author_id"], "text": r["text"]}
+
+
+def add_comment(db, principal, ticket_id, text, idempotency_key):
+    permissions.require(principal, "ticket.comment")
+    ticket_id = validate.db_id(ticket_id, "ticket_id")
+    if not isinstance(text, str) or not text.strip(" "):
+        raise Invalid("text is required")
+    validate.text(text, "text")
+    text = text.strip(" ")
+    if len(text) > MAX_COMMENT_CHARS:
+        raise Invalid(f"text must not exceed {MAX_COMMENT_CHARS} characters")
+    key = idempotency.check_key(idempotency_key)
+    request_hash = idempotency.fingerprint("comment.add", ticket_id=ticket_id, text=text)
+    with transaction(db):
+        tenants.require_live(db, principal, "ticket.comment")
+        saved = idempotency.replay(db, principal, key, request_hash)
+        if saved is not None:
+            return saved  # this exact request was already applied: answer it again, write nothing
+        get_ticket(db, principal, ticket_id)  # tenant-scoped existence check
+        cur = db.execute(
+            "INSERT INTO comments (tenant_id, ticket_id, author_id, text) VALUES (?, ?, ?, ?)",
+            (principal.tenant_id, ticket_id, principal.user_id, text),
+        )
+        comment = {"id": cur.lastrowid, "ticket_id": ticket_id, "author_id": principal.user_id, "text": text}
+        idempotency.remember(db, principal, key, request_hash, comment)
+    return comment
+
+
+def list_comments(db, principal, ticket_id):
+    permissions.require(principal, "ticket.read")
+    ticket_id = validate.db_id(ticket_id, "ticket_id")
+    get_ticket(db, principal, ticket_id)  # tenant-scoped existence check
+    rows = db.execute(
+        "SELECT id, ticket_id, author_id, text FROM comments WHERE ticket_id = ? AND tenant_id = ? ORDER BY id",
+        (ticket_id, principal.tenant_id),
+    ).fetchall()
+    return [_comment(r) for r in rows]
