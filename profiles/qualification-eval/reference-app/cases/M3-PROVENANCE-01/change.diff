+MAX_PAGE = 100
+
+
+def list_tickets(db, principal, limit=50, after_id=0):
+    permissions.require(principal, "ticket.read")
+    if isinstance(limit, bool) or not isinstance(limit, int) or not 1 <= limit <= MAX_PAGE:
+        raise Invalid(f"limit must be an integer from 1 to {MAX_PAGE}")
+    if isinstance(after_id, bool) or not isinstance(after_id, int) or not 0 <= after_id < 2**63:
+        raise Invalid("after_id must be a non-negative integer")
+    rows = db.execute(
+        "SELECT * FROM tickets WHERE tenant_id = ? AND id > ? ORDER BY id LIMIT ?",
+        (principal.tenant_id, after_id, limit),
+    ).fetchall()
+    return {
+        "tickets": [_row(r) for r in rows],
+        "next_after_id": rows[-1]["id"] if len(rows) == limit else None,
+    }
+
+
