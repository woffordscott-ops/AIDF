+class ListTicketsTests(World):
+    def test_lists_only_this_tenants_tickets_in_id_order_and_pages_with_a_cursor(self):
+        mine = [tickets.create_ticket(self.db, self.a("member"), f"t{i}", idempotency_key=nk())["id"] for i in range(5)]
+        tickets.create_ticket(self.db, self.b("owner"), "theirs", idempotency_key=nk())
+        first = tickets.list_tickets(self.db, self.a("viewer"), limit=2)
