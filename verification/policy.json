{
  "schema_version": 1,
  "exemptions_path": "aidf/exemptions",
  "dependency_manifests": [
    ".gitlab-ci.yml",
    ".gitmodules",
    "**/requirements*.txt",
    "**/pyproject.toml",
    "**/poetry.lock",
    "**/package.json",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
    "**/go.mod",
    "**/go.sum",
    "**/Cargo.toml",
    "**/Cargo.lock",
    "**/Gemfile",
    "**/Gemfile.lock",
    "**/pom.xml",
    "**/build.gradle",
    "**/build.gradle.kts",
    "**/Dockerfile*"
  ],
  "dependency_reference_rules": [
    {"pattern": ".gitlab-ci.yml", "term": "image:"},
    {"pattern": ".gitlab-ci.yml", "term": "TRIVY_DB_REPOSITORY:"}
  ],
  "dependency_content_lock": [
    ".gitlab-ci.yml",
    ".gitmodules",
    "**/requirements*.txt",
    "**/pyproject.toml",
    "**/poetry.lock",
    "**/package.json",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
    "**/go.mod",
    "**/go.sum",
    "**/Cargo.toml",
    "**/Cargo.lock",
    "**/Gemfile",
    "**/Gemfile.lock",
    "**/pom.xml",
    "**/build.gradle",
    "**/build.gradle.kts",
    "**/Dockerfile*"
  ],
  "tripwire_paths": [
    {"id": "authentication-authorization-session-permissions", "pattern": "**/auth/**"},
    {"id": "authentication-authorization-session-permissions", "pattern": "**/authorization/**"},
    {"id": "authentication-authorization-session-permissions", "pattern": "**/sessions/**"},
    {"id": "authentication-authorization-session-permissions", "pattern": "**/permissions/**"},
    {"id": "authentication-authorization-session-permissions", "pattern": "**/auth*.*"},
    {"id": "authentication-authorization-session-permissions", "pattern": "**/login*.*"},
    {"id": "authentication-authorization-session-permissions", "pattern": "**/session*.*"},
    {"id": "authentication-authorization-session-permissions", "pattern": "**/permission*.*"},
    {"id": "cryptography-keys-secrets-tokens", "pattern": "**/crypto/**"},
    {"id": "cryptography-keys-secrets-tokens", "pattern": "**/keys/**"},
    {"id": "cryptography-keys-secrets-tokens", "pattern": "**/secrets/**"},
    {"id": "cryptography-keys-secrets-tokens", "pattern": "**/tokens/**"},
    {"id": "destructive-data-migrations", "pattern": "**/migrations/**"},
    {"id": "regulated-data-privacy", "pattern": "**/privacy/**"},
    {"id": "regulated-data-privacy", "pattern": "**/pii/**"},
    {"id": "regulated-data-privacy", "pattern": "**/phi/**"},
    {"id": "payments-billing-entitlements", "pattern": "**/payments/**"},
    {"id": "payments-billing-entitlements", "pattern": "**/billing/**"},
    {"id": "payments-billing-entitlements", "pattern": "**/entitlements/**"},
    {"id": "public-api-compatibility", "pattern": "**/public-api/**"},
    {"id": "infrastructure", "pattern": ".gitlab-ci.yml"},
    {"id": "infrastructure", "pattern": ".github/workflows/**"},
    {"id": "infrastructure", "pattern": "infra/**"},
    {"id": "infrastructure", "pattern": "terraform/**"},
    {"id": "infrastructure", "pattern": "k8s/**"},
    {"id": "infrastructure", "pattern": "kubernetes/**"},
    {"id": "production-configuration", "pattern": "**/production/**"},
    {"id": "production-configuration", "pattern": "**/prod/**"}
  ],
  "tripwire_content_terms": [
    {"id": "destructive-data-migrations", "term": "drop table"},
    {"id": "destructive-data-migrations", "term": "truncate table"},
    {"id": "destructive-data-migrations", "term": "hard delete"},
    {"id": "regulated-data-privacy", "term": "personal data"},
    {"id": "regulated-data-privacy", "term": "protected health information"},
    {"id": "payments-billing-entitlements", "term": "payment entitlement"},
    {"id": "public-api-compatibility", "term": "breaking api change"},
    {"id": "irreversibility", "term": "irreversible"}
  ],
  "tripwire_content_exclude": [
    "core/**",
    "templates/**",
    "metrics/**",
    "verification/**",
    "spec/**",
    "README.md",
    "IMPLEMENTATION-STATUS.md"
  ]
}
